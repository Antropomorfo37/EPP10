# Environment Configuration Template for EPP10 Analysis Pipeline
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore and NOT committed)
# 2. Update paths according to your local system
# 3. Source before running scripts: source .env
#
# DO NOT commit .env file to GitHub — it contains local paths y tokens

# Project root directory (where EPP10 repo is located)
export EPP10_PROJECT_ROOT="${HOME}/EPP10"

# Data directory (input CSVs, normalization maps)
export EPP10_DATA_DIR="${EPP10_PROJECT_ROOT}/data"

# Cache directories for bootstrap pipelines
export EPP10_CACHE_DIR="${EPP10_PROJECT_ROOT}/cache_bootstrap_B2000"
export EPP10_CACHE_PIPELINE="${EPP10_PROJECT_ROOT}/cache_bootstrap_pipeline"

# Output directories
export EPP10_FIGURES_DIR="${EPP10_PROJECT_ROOT}/figures"
export EPP10_VERIFICATION_DIR="${EPP10_PROJECT_ROOT}/verification"
export EPP10_MANUSCRIPT_DIR="${EPP10_PROJECT_ROOT}/manuscript"

# R library paths (optional, for renv isolation)
export R_LIBS_USER="${HOME}/.R/library"

# Parallel computing settings (adjust to your hardware)
export EPP10_N_WORKERS=8

# Seed for reproducibility (DO NOT CHANGE after initial analysis)
export EPP10_SEED=20260422

# Logging
export EPP10_LOG_LEVEL="INFO"  # DEBUG, INFO, WARN, ERROR
export EPP10_LOG_DIR="${EPP10_VERIFICATION_DIR}"

# ============================================================================
# ZENODO CONFIGURATION
# ============================================================================
# Para obtener ZENODO_API_TOKEN:
# 1. Accede a https://zenodo.org/account/settings/applications/
# 2. Click "New application"
# 3. Nombre: "EPP10-automation"
# 4. Redirect URL: http://localhost:5000/callback (o similar)
# 5. Selecciona scopes: "deposit:write", "deposit:read"
# 6. Copia el token
# 7. Asigna aquí (SIN compartir públicamente)

export ZENODO_API_TOKEN="your_zenodo_token_here"
export ZENODO_API_URL="https://zenodo.org/api"
export ZENODO_SANDBOX_URL="https://sandbox.zenodo.org/api"  # Para testing

# ============================================================================
# OSF (Open Science Framework) CONFIGURATION
# ============================================================================
# Para obtener OSF_API_TOKEN:
# 1. Accede a https://osf.io/settings/profile/
# 2. En "Authentication" → "Personal access tokens"
# 3. Click "Create token"
# 4. Nombre: "EPP10-automation"
# 5. Selecciona scopes: "osf.reads:registrations", "osf.writes:registrations"
# 6. Copia el token
# 7. Asigna aquí (SIN compartir públicamente)

export OSF_API_TOKEN="your_osf_token_here"
export OSF_API_URL="https://api.osf.io/v2"
export OSF_PROJECT_ID="xxxxx"  # Tu proyecto OSF - obten después de crear proyecto

# ============================================================================
# GitHub API (para auto-releases y comentarios)
# ============================================================================
# Genera en: https://github.com/settings/tokens
# Scopes necesarios: repo (full), workflow, gist

export GITHUB_TOKEN="your_github_token_here"
export GITHUB_REPO="Antropomorfo37/EPP10"

# ============================================================================
# METADATA PARA DEPOSITOS
# ============================================================================

# Autor principal
export EPP10_AUTHOR_NAME="Héctor Manuel Virgen Ayala"
export EPP10_AUTHOR_ORCID="0009-0006-2081-2286"
export EPP10_AUTHOR_EMAIL="hectorvirgenmd@gmail.com"

# Institución
export EPP10_INSTITUTION="Universidad de Guadalajara"
export EPP10_DEPARTMENT="Departamento de Clínicas Quirúrgicas"

# DOIs asignados (actualizar después de cada publicación)
export ZENODO_DOI_PLACEHOLDER="10.5281/zenodo.XXXXXXX"
export OSF_DOI_PLACEHOLDER="10.17605/OSF.IO/XXXXX"
export MEDRXIV_DOI_PLACEHOLDER="10.1101/2026.MM.DD.XXXXXX"

# Licencia
export EPP10_LICENSE="CC-BY-4.0"
